{
  "name": "robonose-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:data": "node scripts/check-local-data.mjs",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/render.test.mjs tests/dataset.test.mjs tests/testWorkflow.test.ts",
    "format": "prettier --write src server scripts tests index.html vite.config.ts tsconfig.json package.json .prettierrc.json README.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
